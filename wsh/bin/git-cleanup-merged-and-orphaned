#!/usr/bin/env bash

##############################################################################
# Shell Behaviour
##############################################################################

# Check for unbound variables being used
# set -o nounset

# Exit is a bad command is attempted. If you're going to handle errors then
# leave this disabled
# set -o errexit

# Exit if any of the commands in a pipeline exit with a non-zero exit code
# set -o pipefail

##############################################################################
# Variables
##############################################################################

CONST_COMMAND_LINE="$@"
CONST_OS_VERSION=$(uname -r)
CONST_SYSTEM_TYPE=$(uname -m)
CONST_SCRIPT_NAME=${0##*/}
CONST_SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DETECTED_MAIN_BRANCH="$(git remote show origin | grep -oP 'HEAD branch:(.*)' | sed -e 's/HEAD branch: //g')"
COUNT=0

echo "INFO: Detected main branch: ${DETECTED_MAIN_BRANCH}"

git branch --merged "${DETECTED_MAIN_BRANCH}" | grep -vE "^\*|${DETECTED_MAIN_BRANCH}" | while read branch; do
  if git branch -vv | grep -q "^  $branch .*: gone]"; then
    echo git branch -d "$branch"
    ((COUNT++))
  fi
done

echo "INFO: ${COUNT} branches are already merged and can be deleted locally"
