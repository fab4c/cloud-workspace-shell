#!/usr/bin/env bash

##############################################################################
# Shell Behaviour
##############################################################################

# Check for unbound variables being used
# set -o nounset

# Exit is a bad command is attempted. If you're going to handle errors then
# leave this disabled
# set -o errexit

# Exit if any of the commands in a pipeline exit with a non-zero exit code
# set -o pipefail

##############################################################################
# Variables
##############################################################################

CONST_COMMAND_LINE="$@"
CONST_OS_VERSION=$(uname -r)
CONST_SYSTEM_TYPE=$(uname -m)
CONST_SCRIPT_NAME=${0##*/}
CONST_SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

_BUFFER="$(mktemp).buf"

##############################################################################
# Main Script
##############################################################################

if [ "$1" ]; then
    fn="$1"
else
    mkfifo "${_BUFFER}"
    cat <&0 > "${_BUFFER}" &
    fn="${_BUFFER}"
fi

echo 'jsondecode(file("'"${fn}"'"))' | terraform console

if [ -e "${_BUFFER}" ]; then
   rm "${_BUFFER}"
fi
