#!/bin/bash
# filepath: view_file_changes.sh

FILE=$1
if [ -z "$FILE" ]; then
    echo "Usage: $0 <filename>"
    exit 1
fi

# Get all commits that touched this file, from oldest to newest
COMMITS=$(git log --format="%H" --reverse -- "$FILE")

PREV_COMMIT=""
for COMMIT in $COMMITS; do
    COMMIT_DATE=$(git show -s --format="%cd" --date=short $COMMIT)
    COMMIT_MSG=$(git show -s --format="%s" $COMMIT)
    AUTHOR=$(git show -s --format="%an" $COMMIT)
    
    echo "=================================================================="
    echo "Commit: $COMMIT"
    echo "Author: $AUTHOR"
    echo "Date: $COMMIT_DATE"
    echo "Message: $COMMIT_MSG"
    echo "=================================================================="
    
    if [ -z "$PREV_COMMIT" ]; then
        # First commit with this file
        echo "Initial version of the file:"
        git show $COMMIT:"$FILE" 2>/dev/null || echo "File not available in this commit"
    else
        # Show what changed between previous commit and this one
        echo "Changes made in this commit:"
        git diff $PREV_COMMIT..$COMMIT -- "$FILE"
    fi
    
    PREV_COMMIT=$COMMIT
    echo ""
    echo ""
done

